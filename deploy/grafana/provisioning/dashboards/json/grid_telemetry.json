          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT NOW() AS \"time\", COUNT(DISTINCT meter_id) AS \"Active Meters\"\nFROM meter_readings\nWHERE time >= NOW() - INTERVAL '5 minutes';",
