# Infrastructure Endpoints
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_FILTER=meazon/grid/+/meter/+/telemetry
MQTT_SHARE_GROUP=ingest

KAFKA_BROKERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=iot.telemetry.raw
KAFKA_ALERTS_TOPIC=iot.alerts
KAFKA_GROUP_ID_PERSISTER=iot-persister-group
KAFKA_GROUP_ID_ANOMALY=iot-anomaly-group

TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_DB=iot_energy
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iot_energy

MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_USER=mongo_admin
MONGO_PASSWORD=mongo_password
MONGO_DB=iot_twins
MONGO_URI=mongodb://mongo_admin:mongo_password@localhost:27018/iot_twins?authSource=admin

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
API_PORT=8088

# Service Settings
LOG_LEVEL=info
SIMULATOR_METERS=500
SIMULATOR_RATE=1
