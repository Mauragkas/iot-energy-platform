{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GridMeterAlert",
  "description": "Grid anomaly alert emitted by real-time streaming detector",
  "type": "object",
  "required": [
    "time",
    "meter_id",
    "alert_type",
    "severity",
    "value",
    "threshold",
    "message"
  ],
  "properties": {
    "id": {
      "type": ["integer", "string", "null"],
      "description": "Optional sequential or UUID identifier"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of anomaly occurrence"
    },
    "meter_id": {
      "type": "string",
      "pattern": "^MZ-3P-[0-9]{4}$",
      "description": "Meter identifier associated with anomaly"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "VOLTAGE_SAG",
        "VOLTAGE_SWELL",
        "DEMAND_SPIKE",
        "PHASE_IMBALANCE",
        "LOW_POWER_FACTOR",
        "FREQUENCY_DEVIATION"
      ],
      "description": "Classification code of anomaly"
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "CRITICAL"],
      "description": "Alert severity level"
    },
    "value": {
      "type": "number",
      "description": "Observed metric value triggering threshold breach"
    },
    "threshold": {
      "type": "number",
      "description": "Configured or statistical threshold breached"
    },
    "message": {
      "type": "string",
      "description": "Human-readable diagnostic summary"
    }
  },
  "additionalProperties": false
}
